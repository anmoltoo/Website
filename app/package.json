{
  "name": "log-executor",
  "productName": "log",
  "version": "0.1.0",
  "description": "Design-only desktop window of the log executor: the layout and look, no features.",
  "author": "log",
  "repository": "github:anmoltoo/Website",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/chivo": "5.3.0",
    "@fontsource/chivo-mono": "5.3.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.log.executor",
    "productName": "log",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "log-setup.exe"
    }
  }
}
